# ─────────────────────────────────────────────────────────────
# OmniRoute setup. The installer creates and fills this file.
# You only need to edit it by hand for special cases.
# .env is gitignored. Never commit it.
# ─────────────────────────────────────────────────────────────

# Where OmniRoute listens. Keep the host on loopback.
OMNIROUTE_HOST=127.0.0.1
OMNIROUTE_PORT=20128

# Gateway keys. The installer creates both.
#   OMNIROUTE_API_KEY    used by Claude Code for chat
#   OMNIROUTE_ADMIN_KEY  "manage" scope; used for setup and usage reports
OMNIROUTE_API_KEY=
OMNIROUTE_ADMIN_KEY=

# NVIDIA NIM (required, free): https://build.nvidia.com → Get API Key
NVIDIA_NIM_KEY=

# Kiro (optional) uses a browser login, not a key:
#   node scripts/kiro-login.mjs github     (or google)

# ── Advanced ─────────────────────────────────────────────────
# Run OmniRoute from a source checkout instead of the bundled npm copy.
# OMNIROUTE_SOURCE_DIR=
# Claude Code profile for the claude-omni command.
# CLAUDE_PROFILE_DIR=
